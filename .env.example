# Copy this file to .env and fill in the values. Never commit .env.

# Telegram bot token from BotFather (looks like 123456789:AAF...)
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat id (a number). Messages from any other chat are ignored.
# Get it: message your bot once, then open https://api.telegram.org/bot<TOKEN>/getUpdates in a browser
# and copy the "chat":{"id": number.
TELEGRAM_CHAT_ID=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for video extraction
GEMINI_MODEL=gemini-3.6-flash

# Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model used by the chat app
ANTHROPIC_MODEL=claude-sonnet-5
